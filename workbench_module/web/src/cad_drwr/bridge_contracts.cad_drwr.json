{
  "routes": {
    "POST /v1/sap/actions/cad/status": {
      "keys": ["conectado", "programa", "version", "documento", "detalle"]
    },
    "POST /v1/sap/actions/cad/pick": {
      "keys": ["x", "y"]
    },
    "POST /v1/sap/actions/cad/pick/cancel": {
      "keys": ["cancelado"]
    },
    "POST /v1/sap/actions/cad/draw/begin": {
      "keys": ["sesion", "programa", "documento"]
    },
    "POST /v1/sap/actions/cad/draw/batch": {
      "keys": ["creadas", "omitidas", "errores"]
    },
    "POST /v1/sap/actions/cad/draw/end": {
      "keys": ["documento", "creadas", "omitidas", "resumen"]
    },
    "POST /v1/sap/actions/cad/sap/groups": {
      "keys": ["grupos"]
    },
    "POST /v1/sap/actions/cad/sap/foundation/start": {
      "keys": ["job"]
    },
    "POST /v1/sap/actions/cad/sap/foundation/status": {
      "keys": ["estado", "etapa", "hechas", "total", "transcurrido_s", "resultado", "error"],
      "opcionales": ["resultado", "error"]
    },
    "POST /v1/sap/actions/cad/sap/foundation/cancel": {
      "keys": ["cancelado"]
    }
  }
}
